# Copy this file to .env and fill in values.
# NEVER commit a real .env file. Secrets stay on the backend only
# (technical-requirements.md section 30) - the frontend must never read these.

# --- Backend server ---
NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173

# --- Supabase / Postgres (wired up in Phase 6) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (wired up behind the AIProvider abstraction in Phase 8) ---
# "gemini" is the recommended V1 default per technical-requirements.md section 4.6.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
